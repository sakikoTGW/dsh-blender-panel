{
  "name": "@local/dsh-blender-panel",
  "version": "2.5.0",
  "description": "Model Deck: open .blend and .glb models in the sidebar, annotate picks and insert references through the element picker.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "addon/dsh_bridge.py",
    "native/*.ps1",
    "assets/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakikoTGW/dsh-blender-panel.git"
  },
  "homepage": "https://github.com/sakikoTGW/dsh-blender-panel#readme",
  "bugs": {
    "url": "https://github.com/sakikoTGW/dsh-blender-panel/issues"
  },
  "author": "sakikoTGW",
  "license": "MIT",
  "private": true
}
